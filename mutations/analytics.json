    "package": "./analytics",
    "run": "^TestNumericContentIDCanonicalization$"
  },
  {
    "name": "analytics views cannot be incremented by reloads",
    "file": "analytics/analytics.go",
    "before": "VALUES(?,?,?,?,1,?) ON CONFLICT(day,kind,member,item) DO NOTHING",
    "after": "VALUES(?,?,?,?,1,?) ON CONFLICT(day,kind,member,item) DO UPDATE SET count=count+1",
    "package": "./analytics",
    "run": "^TestSQLiteCountQueriesDeduplicateAndExpire$"
  },
  {
    "name": "analytics distinct accounts see independent views",
    "file": "analytics/analytics.go",
    "before": "PRIMARY KEY(day,kind,member,item)",
    "after": "PRIMARY KEY(day,kind,item)",
    "package": "./analytics",
    "run": "^TestSQLiteCountQueriesDeduplicateAndExpire$"
  },
  {
    "name": "analytics views reset per UTC day",
    "file": "analytics/analytics.go",
    "before": "PRIMARY KEY(day,kind,member,item)",
    "after": "PRIMARY KEY(kind,member,item)",
    "package": "./analytics",
    "run": "^TestSQLiteCountQueriesDeduplicateAndExpire$"
  },
  {
    "name": "analytics retains exactly ninety UTC days",
